# ZarinPal Analytical Dashboard — Environment Variables
# Copy to .env and adjust as needed

# Backend (FastAPI + DuckDB)
# Path to the CSV data file (use sample for dev, full dataset for production)
DATA_FILE=data/sample_data.csv
# DuckDB database path (use :memory: for testing)
DUCKDB_PATH=data/analytics.duckdb
# Debug mode
DEBUG=false

# Frontend (Next.js)
# API URL accessible from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Docker
API_PORT=8000
FRONTEND_PORT=3000
