# ===== Project-specific: ZarrinPal Analytics =====

# Dataset — NEVER commit the 500MB CSV or DuckDB files
data/*.csv
data/*.csv.gz
data/*.tsv
data/*.zip
data/*.duckdb
data/*.duckdb.wal
!data/README.md

# Frontend (Node / Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/next-env.d.ts

# Env (never commit secrets)
.env
.env.local
.env.*.local

# Build artifacts
*.pyc
__pycache__/
.pytest_cache/
.mypy_cache/

# ===== Standard Python gitignore =====

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

